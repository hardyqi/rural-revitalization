# ============================================================
# 乡村振兴创新服务平台 · 环境变量
# ============================================================

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# S3 存储（火山引擎 TOS / AWS S3 兼容）
S3_ENDPOINT_URL=https://tos-cn-beijing.volces.com
S3_BUCKET_NAME=rural-revitalization-images
S3_ACCESS_KEY_ID=your-access-key
S3_SECRET_ACCESS_KEY=your-secret-key

# AI 模型（智谱 GLM / DeepSeek）
ZHIPU_API_KEY=your-zhipu-api-key
DEEPSEEK_API_KEY=your-deepseek-api-key

# 图像生成（Seedream 5.0 / 火山引擎）
VOLCENGINE_ACCESS_KEY=your-volcengine-ak
VOLCENGINE_SECRET_KEY=your-volcengine-sk

# CI/CD 部署
DEPLOY_HOST=your-cvm-ip
DEPLOY_USER=root
DEPLOY_PATH=/var/www/rural-revitalization
DEPLOY_PORT=5001
GITHUB_TOKEN=your-github-token
